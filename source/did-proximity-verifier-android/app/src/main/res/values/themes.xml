<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.DidVerifier" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_pale</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="colorSecondary">@color/brand_primary_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorError">@color/brand_error</item>

        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/brand_text_secondary</item>
        <item name="colorOutline">@color/brand_divider</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:fontFamily">@font/pretendard_regular</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.DidVerifier.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.DidVerifier.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.DidVerifier.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.DidVerifier.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.DidVerifier.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.DidVerifier.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DidVerifier.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DidVerifier.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.DidVerifier.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DidVerifier.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DidVerifier.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.DidVerifier.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DidVerifier.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.DidVerifier.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DidVerifier.LabelSmall</item>

        <item name="materialButtonStyle">@style/Widget.DidVerifier.Button.Primary</item>
    </style>

    <style name="Theme.DidVerifier" parent="Base.Theme.DidVerifier" />

    <style name="TextAppearance.DidVerifier.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
