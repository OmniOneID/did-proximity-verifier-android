    </style>
    <style name="TextAppearance.DidVerifier.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidVerifier.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="TextAppearance.DidVerifier.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="TextAppearance.DidVerifier.BodySmall" parent="TextAppearance.Material3.BodySmall">
