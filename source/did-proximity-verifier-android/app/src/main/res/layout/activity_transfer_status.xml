<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:orientation="vertical"
    tools:context=".ui.transfer.TransferStatusActivity">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <org.omnione.did.proximity.verifier.ui.common.widget.SectionTitleView
                android:id="@+id/requestTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="@string/transfer_section_request" />

            <LinearLayout
                android:id="@+id/requestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_bordered"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp" />

            <org.omnione.did.proximity.verifier.ui.common.widget.SectionTitleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:sectionTitle="@string/transfer_section_connection" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white_bordered"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <org.omnione.did.proximity.verifier.ui.common.widget.DotSpinnerView
                    android:id="@+id/spinner"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_medium"
                    app:lineHeight="19.6sp"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="14sp"
                    tools:text="Connecting..." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        android:orientation="vertical">

        <include layout="@layout/view_divider" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dismissButton"
                style="@style/Widget.DidVerifier.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/common_cancel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
